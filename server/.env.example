# MongoDB connection string (without database name; "/job-portal" is appended).
# For local development run `npm run db` and use:
MONGODB_URI=mongodb://127.0.0.1:27017

JWT_SECRET=change-me

# Cloudinary (company logos and resumes)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Clerk (job-seeker login). CLERK_KEY is the webhook signing secret.
CLERK_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
